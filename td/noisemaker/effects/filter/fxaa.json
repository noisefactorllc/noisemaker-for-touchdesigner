{
  "name": "Fxaa",
  "namespace": "filter",
  "func": "fxaa",
  "starter": false,
  "tags": [
    "antialiasing"
  ],
  "description": "Fast approximate anti-aliasing",
  "paramAliases": {},
  "globals": {
    "strength": {
      "type": "float",
      "default": 1,
      "uniform": "strength",
      "min": 0,
      "max": 1
    },
    "sharpness": {
      "type": "float",
      "default": 1,
      "uniform": "sharpness",
      "min": 0.1,
      "max": 10
    },
    "threshold": {
      "type": "float",
      "default": 0,
      "uniform": "threshold",
      "min": 0,
      "max": 1
    }
  },
  "passes": [
    {
      "name": "main",
      "program": "fxaa",
      "inputs": {
        "inputTex": "inputTex"
      },
      "outputs": {
        "fragColor": "outputTex"
      }
    }
  ],
  "textures": {},
  "defaultProgram": "search filter, synth\n\npattern(type: stripes, scale: 10, rotation: 30, smoothness: 0.001, bgColor: #666666)\n  .fxaa()\n  .write(o0)"
}
