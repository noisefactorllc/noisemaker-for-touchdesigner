{
  "name": "Heightmap 3D",
  "namespace": "synth3d",
  "func": "heightmap3d",
  "starter": true,
  "tags": [
    "3d"
  ],
  "description": "Voxel heightfield from separate 2D height and color surfaces",
  "paramAliases": {},
  "globals": {
    "heightTex": {
      "type": "surface",
      "default": "none"
    },
    "tex": {
      "type": "surface",
      "default": "none"
    },
    "volumeSize": {
      "type": "int",
      "default": 64,
      "uniform": "volumeSize",
      "choices": {
        "x16": 16,
        "x32": 32,
        "x64": 64,
        "x128": 128
      }
    },
    "heightScale": {
      "type": "float",
      "default": 0.35,
      "uniform": "heightScale",
      "min": 0,
      "max": 1
    },
    "baseHeight": {
      "type": "float",
      "default": 0,
      "uniform": "baseHeight",
      "min": 0,
      "max": 1
    }
  },
  "passes": [
    {
      "name": "precompute",
      "program": "precompute",
      "inputs": {
        "heightTex": "heightTex",
        "tex": "tex"
      },
      "outputs": {
        "color": "volumeCache",
        "geoOut": "geoBuffer"
      },
      "drawBuffers": 2,
      "type": "compute"
    }
  ],
  "textures": {
    "volumeCache": {
      "width": {
        "param": "volumeSize",
        "default": 64
      },
      "height": {
        "param": "volumeSize",
        "power": 2,
        "default": 4096
      },
      "format": "rgba16f"
    },
    "geoBuffer": {
      "width": {
        "param": "volumeSize",
        "default": 64
      },
      "height": {
        "param": "volumeSize",
        "power": 2,
        "default": 4096
      },
      "format": "rgba16f"
    }
  },
  "defaultProgram": "search synth, synth3d, render\n\nheightmap3d(heightTex: noise(scaleX: 90, scaleY: 90, colorMode: mono, speed: 0), tex: gradient(type: fourCorners, color1: #006e94, color2: #24e4ff, color3: #bcff46, color4: #efffff)).renderLandscape3d(panY: -0.18).write(o0)\nrender(o0)",
  "outputTex3d": "volumeCache",
  "outputGeo": "geoBuffer"
}
