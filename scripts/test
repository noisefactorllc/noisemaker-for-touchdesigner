#!/usr/bin/env bash
# scripts/test — the engine-free test entrypoint for Noisemaker for TouchDesigner.
#
# Runs the suites that need neither TouchDesigner nor a GPU and report 0 skipped:
#   1. the Python unit tests (parity/test_*.py), which must report 0 skipped;
#   2. the compiler parity gates check_lex / check_parse / check_validate, which diff the Python
#      compiler port against the upstream Noisemaker reference compiler run under Node.
#
# Not run here:
#   - rendered parity (parity/run.sh, parity/sweep.sh): needs a licensed TouchDesigner install;
#   - parity/compiler/check_graph.py: its classification reports an agreed rejection
#     (parity/corpus/B5oBsA.dsl, "both reject (invalid program)") as SKIP, and this entrypoint only
#     runs suites that report 0 skipped.
#
# The gates fetch the upstream reference at NM_REFERENCE_SHA_PINNED, so results do not depend on
# upstream HEAD. This variable is the repository's record of the reference it is synced to: a change
# that syncs the port to a newer reference must update it in the same commit.
# NM_REFERENCE_SHA=<full sha> runs the gates against another reference commit.
#
# Works in shallow clones: a commit that a unit test reads and the clone lacks is fetched by SHA.
#
# Requirements: bash, git, node, python3 >= 3.11 (PYTHON=<interpreter> to choose another), network.
# Scratch (venv, reference checkout, logs) lives under ${TMPDIR:-/tmp} and is removed on exit.
set -euo pipefail

NM_REFERENCE_REPO="https://github.com/noisefactorllc/noisemaker.git"
REPO_URL="https://github.com/noisefactorllc/noisemaker-for-touchdesigner.git"
NM_REFERENCE_SHA_PINNED="8395d1da1bb2e787e9c8319b739dcf5bcda1cfb4"
NUMPY_VERSION="2.4.6"

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO"

REF_SHA="${NM_REFERENCE_SHA:-$NM_REFERENCE_SHA_PINNED}"
PYTHON="${PYTHON:-python3}"

# Keep bytecode out of the checkout and the environment hermetic.
export PYTHONDONTWRITEBYTECODE=1
export PIP_DISABLE_PIP_VERSION_CHECK=1
export PIP_NO_INPUT=1
export GIT_TERMINAL_PROMPT=0
unset NM_REFERENCE_ROOT PYTHONPATH VIRTUAL_ENV

fail() { printf 'scripts/test: %s\n' "$*" >&2; exit 1; }

# Printed when the reference cannot be fetched or a gate fails. After an upstream sync, the most
# common cause is a pin that was not updated.
pin_hint() {
  if [[ -n "${NM_REFERENCE_SHA:-}" ]]; then
    printf 'scripts/test: the gates ran against NM_REFERENCE_SHA=%s from the environment.\n' "$REF_SHA" >&2
    return
  fi
  cat >&2 <<HINT
scripts/test: the gates compare the port with the upstream Noisemaker reference at
  NM_REFERENCE_SHA_PINNED=$REF_SHA (set near the top of scripts/test).
That variable is the repository's record of the reference it is synced to. If this change
syncs the port to a newer upstream commit, set
NM_REFERENCE_SHA_PINNED in scripts/test to that commit's full 40-character SHA in the same
commit. If the pin is already the synced reference, the port has diverged from it.
HINT
}

for tool in git node "$PYTHON"; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done
[[ "$REF_SHA" =~ ^[0-9a-f]{40}$ ]] || fail "NM_REFERENCE_SHA must be a full 40-character commit SHA, got: $REF_SHA"
"$PYTHON" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' \
  || fail "$PYTHON is $("$PYTHON" -c 'import platform; print(platform.python_version())'); 3.11 or newer is required"

# parity/test_materialize_kit.py reads an earlier commit of this repository (its OLD_SOURCE) with
# git ls-tree and git show. A shallow clone can lack it: fetch that one commit, not the history.
git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || fail "$REPO is not a git checkout; parity/test_materialize_kit.py reads this repository's commits"
while IFS= read -r sha; do
  if git cat-file -e "$sha^{commit}" 2>/dev/null; then continue; fi
  echo "fetching $sha (read by parity/test_materialize_kit.py, missing from this clone)"
  git fetch --quiet --no-tags --depth=1 origin "$sha" </dev/null \
    || git fetch --quiet --no-tags --depth=1 "$REPO_URL" "$sha" </dev/null \
    || fail "cannot fetch $sha, which parity/test_materialize_kit.py reads, from origin or $REPO_URL"
  git cat-file -e "$sha^{commit}" 2>/dev/null || fail "commit $sha is still missing after the fetch"
done < <(sed -nE "s/^OLD_SOURCE = '([0-9a-f]{40})'.*$/\1/p" parity/test_materialize_kit.py)

WORK="$(mktemp -d "${TMPDIR:-/tmp}/nm-td-test.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT
VENV="$WORK/venv"
REF="$WORK/noisemaker"
LOGS="$WORK/logs"
mkdir -p "$LOGS"

START=$SECONDS
echo "== environment"
echo "repo:      $REPO ($(git -C "$REPO" rev-parse HEAD 2>/dev/null || echo 'not a git checkout'))"
echo "python:    $("$PYTHON" -c 'import sys; print(sys.executable, sys.version.split()[0])')"
echo "node:      $(node --version)"
echo "reference: $NM_REFERENCE_REPO @ $REF_SHA"

echo "== python environment (numpy==$NUMPY_VERSION)"
mkdir -p "$VENV/lib64"
if "$PYTHON" -m venv --copies "$VENV" >"$LOGS/venv.log" 2>&1; then
  "$VENV/bin/python" -m pip install --quiet --only-binary=:all: "numpy==$NUMPY_VERSION" pillow
elif command -v uv >/dev/null 2>&1; then
  # Use uv to install packages when ensurepip is unavailable.
  cat "$LOGS/venv.log"
  echo "python -m venv failed; retrying without pip"
  rm -rf "$VENV"
  mkdir -p "$VENV/lib64"
  "$PYTHON" -m venv --without-pip --copies "$VENV" \
    || fail "cannot create a regular-file environment: install the python venv module"
  uv pip install --quiet --link-mode copy --python "$VENV/bin/python" --only-binary=:all: "numpy==$NUMPY_VERSION" pillow
else
  cat "$LOGS/venv.log" >&2
  fail "cannot create a regular-file environment: install the python venv module with ensurepip"
fi
VPY="$VENV/bin/python"
export PATH="$VENV/bin:$PATH"
"$VPY" -c 'import numpy, sys; print("venv:", sys.executable, sys.version.split()[0], "numpy", numpy.__version__)'

echo "== reference checkout"
git -c init.defaultBranch=main init --quiet "$REF"
fetched=0
for attempt in 1 2 3; do
  if git -C "$REF" fetch --quiet --depth 1 "$NM_REFERENCE_REPO" "$REF_SHA"; then
    fetched=1
    break
  fi
  echo "fetch attempt $attempt failed"
  if [[ $attempt -lt 3 ]]; then sleep $((attempt * 5)); fi
done
if [[ $fetched -ne 1 ]]; then
  pin_hint
  fail "cannot fetch $REF_SHA from $NM_REFERENCE_REPO"
fi
git -C "$REF" config core.symlinks false
git -C "$REF" -c core.symlinks=false -c advice.detachedHead=false checkout --quiet FETCH_HEAD
GOT_SHA="$(git -C "$REF" rev-parse HEAD)"
[[ "$GOT_SHA" == "$REF_SHA" ]] || fail "reference checkout is $GOT_SHA, expected $REF_SHA"
echo "reference checked out at $GOT_SHA"

# The unit phase runs in the background, in parallel with the compiler gates:
# the operator limit is one invocation within 300 seconds, and the full gate
# set alone exceeds it when run sequentially after the unit phase.
(
  set +e
  env -u NM_REFERENCE_SHA -u NM_REFERENCE_OBJECT_STORE "$VPY" - <<'PY'
import glob
import os
import sys
import unittest

sys.path.insert(0, 'parity')

CHANGED_FILES = [f.strip() for f in os.environ.get('NM_CHANGED_FILES', '').split('\n') if f.strip()]

# The changed-paths mapping lives in parity/nm_changed_files.py, shared with the
# unit tests that hold it to its contract (including the shader routing).
import nm_changed_files
find_relevant_test_modules = nm_changed_files.find_relevant_test_modules

loader = unittest.defaultTestLoader
filtered_to_empty = False
empty_shard = False
if CHANGED_FILES:
    relevant = find_relevant_test_modules(CHANGED_FILES)
    if relevant:
        print('NM_CHANGED_FILES: filtering to %s' % ', '.join(relevant))
        suite = unittest.TestSuite()
        for module in relevant:
            suite.addTests(loader.loadTestsFromName(module))
    else:
        # The changed paths are exercised by the compiler gates (a changed
        # .dsl program runs on itself; a changed gate script or the runner
        # runs the full program set), not by any unit test module. Run no
        # unit tests: the full suite is not a substitute for the gates.
        print('NM_CHANGED_FILES: no unit test exercises the changed paths; unit tests skipped (gates cover them)')
        suite = unittest.TestSuite()
        filtered_to_empty = True
else:
    suite = loader.discover(start_dir='parity', pattern='test_*.py')

# Sharded changed-path runs: the changed paths can route to test modules whose
# full run exceeds one 300-second invocation. .nm-test-shards at the repository
# root declares the shard count; when the caller passes NM_SHARD_INDEX and
# NM_SHARD_COUNT, only that shard's individual tests run, and together the
# shards run every selected test. With the variables unset nothing changes:
# the selected suite runs whole, exactly as before. Failing loudly on a
# malformed or out-of-range shard selection keeps coverage from being
# silently dropped.
shard_index = os.environ.get('NM_SHARD_INDEX')
shard_count = os.environ.get('NM_SHARD_COUNT')
if shard_index is not None or shard_count is not None:
    if not shard_index.isdigit() or not shard_count.isdigit():
        print('shard: NM_SHARD_INDEX and NM_SHARD_COUNT must be integers')
        sys.exit(2)
    index, count = int(shard_index), int(shard_count)
    if count < 2 or index >= count:
        print('shard: NM_SHARD_INDEX %d out of range for NM_SHARD_COUNT %d' % (index, count))
        sys.exit(2)
    flat = []
    def flatten(s):
        for t in s:
            if isinstance(t, unittest.TestSuite):
                flatten(t)
            else:
                flat.append(t)
    flatten(suite)
    selected = [t for i, t in enumerate(flat) if i % count == index]
    empty_shard = not selected and bool(flat)
    print('shard: running test shard %d of %d (%d of %d tests)' % (index, count, len(selected), len(flat)))
    suite = unittest.TestSuite(selected)

result = unittest.TextTestRunner(verbosity=1).run(suite)
skipped = len(result.skipped)
xfail = len(result.expectedFailures)
xpass = len(result.unexpectedSuccesses)
print('unit tests: run=%d failures=%d errors=%d skipped=%d expected_failures=%d unexpected_successes=%d' % (
    result.testsRun, len(result.failures), len(result.errors), skipped, xfail, xpass))
ok = result.wasSuccessful() and (result.testsRun > 0 or filtered_to_empty or empty_shard) and skipped == 0 and xfail == 0 and xpass == 0
sys.exit(0 if ok else 1)
PY
  echo "$?" > "$LOGS/unit.rc"
) > "$LOGS/unit.log" 2>&1 &
UNIT_PID=$!

# The gates' program set: parity/corpus/*.dsl + parity/programs/*.dsl. When
# NM_CHANGED_FILES is set, only programs that exercise the changed paths run:
# a changed .dsl program runs on itself; a change under td/noisemaker/compiler/
# (the shared parser/validator), to a gate script (parity/compiler/check_*.py),
# to a reference dump tool (tools/dump-*.mjs, which feeds every gate), or to the
# gate runner itself exercises every program; a change to an effect
# definition (td/noisemaker/effects/) exercises the programs that call that
# effect; other changed files (shaders, tests) exercise no DSL program, so the
# gates are skipped. With the variable unset the full set runs.
GATE_FILES=()
while IFS= read -r f; do GATE_FILES+=("$f"); done < <("$VPY" - <<'PY'
import os
import sys
sys.path.insert(0, 'parity')
import nm_changed_files
changed = [l.strip() for l in os.environ.get('NM_CHANGED_FILES', '').splitlines() if l.strip()]
selected = nm_changed_files.select_gate_programs(changed)
if selected:
    print('\n'.join(selected))
PY
)
EXPECTED="${#GATE_FILES[@]}"
GATES_SKIPPED=0
if [[ "$EXPECTED" -eq 0 && -n "${NM_CHANGED_FILES:-}" ]]; then
  echo "== compiler gates: no DSL program exercises the changed paths; skipped"
  GATES_SKIPPED=1
elif [[ "$EXPECTED" -eq 0 ]]; then
  fail "no DSL programs found under parity/corpus or parity/programs"
fi

# Each gate runs in its own background job writing to its own log; the wait
# below bounds the worker count at one unit phase plus three gates. Exit codes
# and the summary lines are verified after the wait, in the main shell.
gate_pids=()
run_gate_bg() {
  local gate="$1"
  (
    set +e
    NM_REFERENCE_ROOT="$REF" "$VPY" "parity/compiler/$gate.py" "${GATE_FILES[@]+"${GATE_FILES[@]}"}" > "$LOGS/$gate.log" 2>&1
    echo "$?" > "$LOGS/$gate.rc"
  ) &
  gate_pids+=("$!")
}

if [[ "$GATES_SKIPPED" -eq 0 ]]; then
  run_gate_bg check_lex
  run_gate_bg check_parse
  run_gate_bg check_validate
fi

wait "$UNIT_PID" ${gate_pids[@]+"${gate_pids[@]}"} || true

echo "== unit tests: parity/test_*.py"
cat "$LOGS/unit.log"
if [[ "$(cat "$LOGS/unit.rc")" -ne 0 ]]; then
  fail "unit tests failed"
fi

for pair in check_lex:lexer check_parse:parser check_validate:validator; do
  gate="${pair%%:*}" label="${pair#*:}"
  if [[ "$GATES_SKIPPED" -eq 1 ]]; then break; fi
  echo "== compiler gate: parity/compiler/$gate.py"
  cat "$LOGS/$gate.log"
  if [[ "$(cat "$LOGS/$gate.rc")" -ne 0 ]]; then
    pin_hint
    fail "$gate failed"
  fi
  summary="$(grep -E "^=== $label parity: [0-9]+/[0-9]+ PASS ===$" "$LOGS/$gate.log" | tail -n 1)" \
    || fail "$gate printed no summary line"
  pass="$(sed -E 's/^=== .* ([0-9]+)\/([0-9]+) PASS ===$/\1/' <<<"$summary")"
  total="$(sed -E 's/^=== .* ([0-9]+)\/([0-9]+) PASS ===$/\2/' <<<"$summary")"
  if [[ "$pass" != "$total" || "$total" != "$EXPECTED" ]]; then
    pin_hint
    fail "$gate passed $pass of $total programs; expected $EXPECTED of $EXPECTED"
  fi
done

echo "== all engine-free suites passed in $((SECONDS - START))s"
