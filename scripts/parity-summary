#!/usr/bin/env python3
"""parity-summary — run the rendered parity sweep in TouchDesigner and print a PARITY-SUMMARY line.

The last output line is
  PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":0,"fail":N,"missing":N}

`expected` is the staged render set (parity/out/_render_set.txt, written by
parity/stage_coverage.py from parity/programs/). Each case is classified from the sweep's ledger:
  exact    PASS with max-abs-diff below one 8-bit step (byte-identical)
  strict   PASS: max-abs-diff <= 2 and SSIM >= 0.98 (the port's strict gate)
  near     NEAR: passes only the wider per-effect tolerance in parity/sweep.sh
  defer    DEFER: graded elsewhere (multi-frame feedback, parity/accumulate.sh)
  fail     FAIL, or any other verdict
  missing  in the render set but absent from the ledger
`executed` counts exact + strict + near + fail.

Goldens are rendered by the sweep from the reference engine at NM_REFERENCE_ROOT. The entrypoint
requires that checkout at the revision pinned in scripts/test (NM_REFERENCE_SHA_PINNED). A stale
checkout is moved to the pin first: git fetch, then checkout, then re-check the head. A checkout
that is not a git clone, or a fetch that fails, falls back to a vendored engine clone in this
repository (upstream-noisemaker/) when that clone sits exactly at the pin. The guard still fails
closed when no usable reference at the pin exists.

Usage:
  NM_REFERENCE_ROOT=/path/to/noisemaker scripts/parity-summary
  scripts/parity-summary --ledger PATH   # classify an existing ledger; render nothing

Environment: NM_PARITY_WORK (work dir, default parity/out/parity-summary) plus everything
parity/sweep.sh and parity/run.sh read (TD_BIN, CHUNK, ...).

Exit code 0 only when fail == missing == 0.
"""
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RENDER_SET = ROOT / "parity" / "out" / "_render_set.txt"
STRICT_TOLERANCE = 2.001
STRICT_SSIM_MIN = 0.98


def pinned_revision():
    """NM_REFERENCE_SHA_PINNED from scripts/test."""
    text = (ROOT / "scripts" / "test").read_text()
    match = re.search(r'^NM_REFERENCE_SHA_PINNED="([0-9a-f]{40})"$', text, re.M)
    if not match:
        raise SystemExit("parity-summary: no NM_REFERENCE_SHA_PINNED in scripts/test")
    return match.group(1)


def read_ledger(path):
    rows = {}
    lines = Path(path).read_text().splitlines()
    for line in lines[1:]:
        cols = line.split("\t")
        if cols and cols[0]:
            rows[cols[0]] = cols
    return rows


def classify(row):
    """Map one ledger row to a PARITY-SUMMARY class."""
    if row is None:
        return "missing"
    verdict = row[1] if len(row) > 1 else ""
    if verdict == "DEFER":
        return "defer"
    if verdict == "NEAR":
        return "near"
    if verdict != "PASS":
        return "fail"
    try:
        max_diff = float(row[2])
        ssim = float(row[3])
    except (IndexError, ValueError):
        return "fail"
    if max_diff < 0.5:
        return "exact"
    if max_diff <= STRICT_TOLERANCE and ssim >= STRICT_SSIM_MIN:
        return "strict"
    return "near"


def summarize(expected, rows):
    counts = {"expected": len(expected), "executed": 0, "exact": 0, "strict": 0, "near": 0,
              "defer": 0, "skip": 0, "fail": 0, "missing": 0}
    lines = []
    for name in expected:
        cls = classify(rows.get(name))
        counts[cls] += 1
        if cls in ("exact", "strict", "near", "fail"):
            counts["executed"] += 1
        row = rows.get(name)
        detail = "" if row is None else " max_abs_diff=%s ssim=%s" % (row[2], row[3])
        lines.append("[%6s] %s%s" % (cls, name, detail))
    return counts, lines


def reference_head(ref_root):
    result = subprocess.run(["git", "-C", str(ref_root), "rev-parse", "HEAD"],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def align_reference(ref_root, pin):
    """Move a stale reference checkout to the pin. Returns (head, error).

    A git clone is fetched and checked out at the pin. Anything else (not a
    clone, fetch failure, checkout failure) returns the observed head so the
    caller fails closed with the guard message.
    """
    if subprocess.run(["git", "-C", str(ref_root), "rev-parse", "--is-inside-work-tree"],
                      capture_output=True, text=True).stdout.strip() != "true":
        return None, "not a git clone"
    fetch = subprocess.run(["git", "-C", str(ref_root), "fetch", "origin", pin],
                           capture_output=True, text=True)
    if fetch.returncode != 0:
        return reference_head(ref_root), "fetch origin %s failed: %s" % (pin, fetch.stderr.strip())
    checkout = subprocess.run(["git", "-C", str(ref_root), "checkout", "--detach",
                               pin], capture_output=True, text=True)
    if checkout.returncode != 0:
        return reference_head(ref_root), "checkout %s failed: %s" % (pin, checkout.stderr.strip())
    head = reference_head(ref_root)
    return head, None if head == pin else "checkout did not land on the pin"


def vendored_reference(pin):
    """A vendored engine clone inside this repository, when it sits exactly at the pin.

    The vendored tree carries the node_modules the golden renderer needs, so it is the
    reference of record for gate runs that cannot reach the network or cannot read an
    externally mounted checkout. Returns the path or None.
    """
    candidate = ROOT / "upstream-noisemaker"
    if candidate.is_dir() and reference_head(str(candidate)) == pin:
        return str(candidate)
    return None


def resolve_reference():
    """NM_REFERENCE_ROOT aligned to the pin, or the vendored clone, or None."""
    pin = pinned_revision()
    ref_root = os.environ.get("NM_REFERENCE_ROOT")
    if ref_root:
        head = reference_head(ref_root)
        if head == pin:
            return ref_root
        head, err = align_reference(ref_root, pin)
        if head == pin:
            return ref_root
    else:
        err = "not set"
    vendored = vendored_reference(pin)
    if vendored:
        return vendored
    raise SystemExit("parity-summary: NM_REFERENCE_ROOT is at %s, not the pinned revision %s (%s)"
                     % (head, pin, err))


def main(argv):
    sweep_status = 0
    if argv[:1] == ["--ledger"] and len(argv) == 2:
        ledger = Path(argv[1])
    elif not argv:
        ref_root = resolve_reference()
        pin = pinned_revision()
        print("parity-summary: reference root %s at %s" % (ref_root, pin))
        work = Path(os.environ.get("NM_PARITY_WORK", ROOT / "parity" / "out" / "parity-summary"))
        work.mkdir(parents=True, exist_ok=True)
        ledger = work / "ledger.tsv"
        if ledger.exists():
            ledger.unlink()
        env = dict(os.environ, LEDGER_PATH=str(ledger), NM_REFERENCE_ROOT=ref_root, NM_REFERENCE_SHA=pin)
        sweep_status = subprocess.run(
            ["bash", str(ROOT / "parity" / "sweep.sh")], cwd=str(ROOT), env=env).returncode
    else:
        raise SystemExit(__doc__)
    expected = RENDER_SET.read_text().split() if RENDER_SET.exists() else []
    rows = read_ledger(ledger) if ledger.exists() else {}
    counts, lines = summarize(expected, rows)
    for line in lines:
        print(line)
    print("PARITY-SUMMARY " + json.dumps(counts, separators=(",", ":")))
    return 0 if (sweep_status == 0 and counts["expected"]
                 and counts["fail"] == 0 and counts["missing"] == 0) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
