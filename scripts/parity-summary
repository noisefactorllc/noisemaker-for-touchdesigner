#!/usr/bin/env python3
"""parity-summary — run the rendered parity sweep in TouchDesigner and print a PARITY-SUMMARY line.

The last output line is
  PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":0,"fail":N,"missing":N}

`expected` is the staged render set (parity/out/_render_set.txt, written by
parity/stage_coverage.py from parity/programs/). Each case is classified from the sweep's ledger:
  exact    PASS with max-abs-diff below one 8-bit step (byte-identical)
  strict   PASS: max-abs-diff <= 2 and SSIM >= 0.98 (the port's strict gate)
  near     NEAR: passes only the wider per-effect tolerance in parity/sweep.sh
  defer    DEFER: graded elsewhere (multi-frame feedback, parity/accumulate.sh)
  fail     FAIL, or any other verdict
  missing  in the render set but absent from the ledger
`executed` counts exact + strict + near + fail.

Goldens are rendered by the sweep from the reference engine at NM_REFERENCE_ROOT. The entrypoint
requires that checkout at the revision pinned in scripts/test (NM_REFERENCE_SHA_PINNED). A stale
checkout is moved to the pin first: git fetch, then checkout, then re-check the head. When no
usable reference checkout exists, the entrypoint provides one itself, in this order:
a vendored engine clone inside this repository (upstream-noisemaker/) when it sits exactly at
the pin, then a managed checkout that this entrypoint fetches from the upstream repository at
the pin (the same fetch-by-SHA the gates in scripts/test use). The guard still fails closed
when no reference at the pin can be provided.

Usage:
  NM_REFERENCE_ROOT=/path/to/noisemaker scripts/parity-summary
  scripts/parity-summary                  # render + compare + classify the whole port
  scripts/parity-summary CASE [CASE ...]  # render + compare + classify only these staged cases
  scripts/parity-summary --ledger PATH    # classify an existing ledger; render nothing.
                                          # The ledger must carry a binding from the sweep
                                          # writer at this checkout and the current pin

Environment: NM_PARITY_WORK (work dir, default parity/out/parity-summary) plus everything
parity/sweep.sh and parity/run.sh read (TD_BIN, CHUNK, ...).

Exit code 0 only when fail == missing == 0.

The rendered cases run TouchDesigner, so the whole-port run fails closed before any
rendering when no TouchDesigner binary can run (TD_BIN, /Applications, PATH or
the common install prefixes) and no ledger bound to this checkout's HEAD and the
pin exists in the work directory. When TouchDesigner cannot run and such a bound
ledger exists, the whole-port run grades that ledger instead of rendering: the
binding proves the rows come from the sweep at this exact source and pin. Run it
on a licensed TouchDesigner host, or with a ledger that sweep produced on one.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
RENDER_SET = ROOT / "parity" / "out" / "_render_set.txt"
REFERENCE_REPO = "https://github.com/noisefactorllc/noisemaker.git"
STRICT_TOLERANCE = 2.001
STRICT_SSIM_MIN = 0.98


def pinned_revision():
    """NM_REFERENCE_SHA_PINNED from scripts/test."""
    text = (ROOT / "scripts" / "test").read_text()
    match = re.search(r'^NM_REFERENCE_SHA_PINNED="([0-9a-f]{40})"$', text, re.M)
    if not match:
        raise SystemExit("parity-summary: no NM_REFERENCE_SHA_PINNED in scripts/test")
    return match.group(1)


def read_ledger(path):
    rows = {}
    lines = Path(path).read_text().splitlines()
    for line in lines[1:]:
        cols = line.split("\t")
        if cols and cols[0]:
            rows[cols[0]] = cols
    return rows


def classify(row):
    """Map one ledger row to a PARITY-SUMMARY class."""
    if row is None:
        return "missing"
    verdict = row[1] if len(row) > 1 else ""
    if verdict == "DEFER":
        return "defer"
    if verdict == "NEAR":
        return "near"
    if verdict != "PASS":
        return "fail"
    try:
        max_diff = float(row[2])
        ssim = float(row[3])
    except (IndexError, ValueError):
        return "fail"
    if max_diff < 0.5:
        return "exact"
    if max_diff <= STRICT_TOLERANCE and ssim >= STRICT_SSIM_MIN:
        return "strict"
    return "near"


def summarize(expected, rows):
    counts = {"expected": len(expected), "executed": 0, "exact": 0, "strict": 0, "near": 0,
              "defer": 0, "skip": 0, "fail": 0, "missing": 0}
    lines = []
    for name in expected:
        cls = classify(rows.get(name))
        counts[cls] += 1
        if cls in ("exact", "strict", "near", "fail"):
            counts["executed"] += 1
        row = rows.get(name)
        detail = "" if row is None else " max_abs_diff=%s ssim=%s" % (row[2], row[3])
        lines.append("[%6s] %s%s" % (cls, name, detail))
    return counts, lines


def reference_head(ref_root):
    result = subprocess.run(["git", "-C", str(ref_root), "rev-parse", "HEAD"],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def align_reference(ref_root, pin):
    """Move a stale reference checkout to the pin. Returns (head, error).

    A git clone is fetched and checked out at the pin. Anything else (not a
    clone, fetch failure, checkout failure) returns the observed head so the
    caller fails closed with the guard message.
    """
    if subprocess.run(["git", "-C", str(ref_root), "rev-parse", "--is-inside-work-tree"],
                      capture_output=True, text=True).stdout.strip() != "true":
        return None, "not a git clone"
    fetch = subprocess.run(["git", "-C", str(ref_root), "fetch", "origin", pin],
                           capture_output=True, text=True)
    if fetch.returncode != 0:
        return reference_head(ref_root), "fetch origin %s failed: %s" % (pin, fetch.stderr.strip())
    checkout = subprocess.run(["git", "-C", str(ref_root), "checkout", "--detach",
                               pin], capture_output=True, text=True)
    if checkout.returncode != 0:
        return reference_head(ref_root), "checkout %s failed: %s" % (pin, checkout.stderr.strip())
    head = reference_head(ref_root)
    return head, None if head == pin else "checkout did not land on the pin"


def vendored_reference(pin):
    """A vendored engine clone inside this repository, when it sits exactly at the pin.

    The vendored tree carries the node_modules the golden renderer needs, so it is the
    reference of record for gate runs that cannot reach the network or cannot read an
    externally mounted checkout. Returns the path or None.
    """
    candidate = ROOT / "upstream-noisemaker"
    if candidate.is_dir() and reference_head(str(candidate)) == pin:
        return str(candidate)
    return None


def provision_reference(work, pin):
    """Fetch the pinned engine revision into the managed work directory.

    This is the entrypoint's own reference: a fresh checkout fetched by SHA from the
    upstream repository, the same mechanism scripts/test uses for its gates. A checkout
    already at the pin is reused. Returns the path or None.
    """
    target = work / "reference"
    if reference_head(str(target)) == pin:
        return str(target)
    init = subprocess.run(["git", "-c", "init.defaultBranch=main", "init", "--quiet", str(target)],
                          capture_output=True, text=True)
    if init.returncode != 0:
        return None
    fetch = subprocess.run(["git", "-C", str(target), "fetch", "--quiet", "--depth", "1",
                            REFERENCE_REPO, pin], capture_output=True, text=True)
    if fetch.returncode != 0:
        return None
    checkout = subprocess.run(["git", "-C", str(target), "checkout", "--quiet", "--detach",
                               "FETCH_HEAD"], capture_output=True, text=True)
    if checkout.returncode != 0 or reference_head(str(target)) != pin:
        return None
    return str(target)


def reference_harness_ready(ref_root):
    """True when the reference's browser harness can resolve its playwright import."""
    harness = Path(ref_root) / "vendor" / "shade-mcp" / "harness"
    if shutil.which("node") is None:
        return False
    probe = subprocess.run(
        ["node", "-e", "process.stdout.write(require.resolve('playwright',"
         " {paths: [process.argv[1]]}))", str(harness)],
        capture_output=True, text=True)
    return probe.returncode == 0 and bool(probe.stdout.strip())


def reference_browser_ready(ref_root, browsers_path=None):
    """True when the reference's playwright can launch chromium the way the harness does.

    A browser that merely exists is not enough: a cache on a noexec mount or a
    truncated download yields a browser that cannot be launched, so the probe
    launches it headless and closes it.
    browsers_path names the cache the probe resolves the browser in.
    """
    harness = Path(ref_root) / "vendor" / "shade-mcp" / "harness"
    if shutil.which("node") is None:
        return False
    env = os.environ
    if browsers_path:
        env = dict(os.environ, PLAYWRIGHT_BROWSERS_PATH=str(browsers_path))
    probe = subprocess.run(
        ["node", "-e",
         "const p=require(require.resolve('playwright',{paths:[process.argv[1]]}));"
         "(async()=>{try{const b=await p.chromium.launch({headless:true,"
         "args:['--disable-gpu-sandbox']});await b.close();"
         "process.stdout.write('true')}catch(e){process.stdout.write('false')}})()",
         str(harness)],
        capture_output=True, text=True, env=env, timeout=300)
    return probe.stdout.strip() == "true"


CA_BUNDLES = ("/etc/ssl/cert.pem", "/etc/ssl/certs/ca-certificates.crt")


def _run_with_ca_retry(argv, env=None):
    """Run an install command; retry once with the system CA bundle on a TLS failure.

    Returns the last CompletedProcess and the extra environment of the successful
    attempt (a NODE_EXTRA_CA_CERTS retry reports its bundle so later stages can reuse
    the same trust anchors).
    """
    result = subprocess.run(argv, capture_output=True, text=True, env=env)
    extra_env = {}
    if result.returncode != 0 and "NODE_EXTRA_CA_CERTS" not in os.environ:
        for bundle in CA_BUNDLES:
            if not os.path.isfile(bundle):
                continue
            extra_env = {"NODE_EXTRA_CA_CERTS": bundle}
            merged = dict(os.environ)
            merged.update(env or {})
            merged["NODE_EXTRA_CA_CERTS"] = bundle
            result = subprocess.run(argv, capture_output=True, text=True, env=merged)
            break
    return result, extra_env


def install_reference_dependencies(ref_root, work):
    """Install the reference's npm dependencies and browser when rendering lacks them.

    The golden renderer imports the browser harness from the reference tree, so the
    reference needs its dependencies installed. This is the same npm ci the native
    parity profile runs before rendering. A torn node_modules (for example one left
    by an interrupted install) fails the resolution probe, and npm ci rebuilds it from
    scratch. A missing or unlaunchable chromium fails the browser probe, and the
    reference's own playwright CLI installs it — first into the default cache (or the
    cache PLAYWRIGHT_BROWSERS_PATH names), then, when that cache cannot execute the
    binary (a noexec home mount), into a managed cache inside the work directory,
    which the caller must pass to the sweep as PLAYWRIGHT_BROWSERS_PATH. When an
    install fails because a TLS root is missing (a local filtering proxy re-signs the
    connection), the install retries with the standard CA bundle of the operating
    system added through NODE_EXTRA_CA_CERTS. Verification stays strict; the retry
    only adds the operating system's own trust anchors.
    Returns (error string or None, extra environment for the sweep).
    """
    extra_env = {}
    if not (Path(ref_root) / "package.json").is_file():
        return "the reference has no package.json", extra_env
    harness_ready = reference_harness_ready(ref_root)
    if harness_ready and reference_browser_ready(ref_root):
        return None, extra_env
    npm = shutil.which("npm")
    if npm is None and not harness_ready:
        return "npm is not on PATH to install the reference's dependencies", extra_env
    if not harness_ready:
        result, ca_env = _run_with_ca_retry(
            [npm, "ci", "--ignore-scripts", "--no-audit", "--no-fund", "--prefix", str(ref_root)])
        if result.returncode != 0 or not reference_harness_ready(ref_root):
            return "npm ci in the reference failed: %s" % result.stderr.strip()[:400], extra_env
        extra_env.update(ca_env)
    if not reference_browser_ready(ref_root):
        cli = Path(ref_root) / "node_modules" / "playwright-core" / "cli.js"
        if not cli.is_file():
            return "the reference has no playwright CLI to install its browser", extra_env
        argv = ["node", str(cli), "install", "chromium"]
        result, ca_env = _run_with_ca_retry(argv)
        if not reference_browser_ready(ref_root):
            # The cache is platform-specific: a managed cache shared between hosts holds
            # binaries the other platform cannot launch, and the installer would then skip
            # the download as already done. Tag the managed cache with the running platform.
            managed = Path(work) / ("browsers-" + sys.platform)
            result, ca_env = _run_with_ca_retry(
                argv, env=dict(os.environ, PLAYWRIGHT_BROWSERS_PATH=str(managed), **ca_env))
            if not reference_browser_ready(ref_root, managed):
                detail = result.stderr.strip()[:400] or "the browser does not launch"
                return "the reference browser install failed: %s" % detail, extra_env
            extra_env.update(ca_env)
            extra_env["PLAYWRIGHT_BROWSERS_PATH"] = str(managed)
        elif ca_env:
            extra_env.update(ca_env)
    return None, extra_env


def resolve_reference(work):
    """NM_REFERENCE_ROOT aligned to the pin, the vendored clone, or a managed fetch."""
    pin = pinned_revision()
    ref_root = os.environ.get("NM_REFERENCE_ROOT")
    if ref_root:
        head = reference_head(ref_root)
        if head == pin:
            return ref_root
        head, err = align_reference(ref_root, pin)
        if head == pin:
            return ref_root
    else:
        err = "not set"
    vendored = vendored_reference(pin)
    if vendored:
        return vendored
    provisioned = provision_reference(work, pin)
    if provisioned:
        return provisioned
    raise SystemExit("parity-summary: no reference checkout at the pinned revision %s (%s); "
                     "set NM_REFERENCE_ROOT to a noisemaker checkout at that revision"
                     % (pin, err))


def touchdesigner_binary():
    """The TouchDesigner binary the sweep will launch, or None when absent.

    Same discovery order as parity/run.sh: TD_BIN, the /Applications installs,
    PATH, then the common install prefixes. A binary that exists but cannot
    execute is treated as absent, and a macOS .app binary must also expose a
    readable bundle version (the same probe the native profile uses), so a
    truncated install fails closed before rendering.
    """
    candidates = []
    env_bin = os.environ.get("TD_BIN", "")
    if env_bin:
        candidates.append(env_bin)
    app_dir = Path("/Applications")
    if app_dir.is_dir():
        candidates += [str(p) for p in sorted(app_dir.glob("TouchDesigner*.app/Contents/MacOS/TouchDesigner"))]
    found = shutil.which("TouchDesigner") or shutil.which("touchdesigner")
    if found:
        candidates.append(found)
    home = Path.home()
    for base in ("/opt/TouchDesigner", "/opt/touchdesigner", "/usr/local/TouchDesigner",
                 "/usr/local/touchdesigner", home / "TouchDesigner", home / "touchdesigner"):
        candidates += [str(Path(base) / s) for s in ("bin/TouchDesigner", "bin/touchdesigner",
                                                     "bin/TouchDesigner.exe",
                                                     "Contents/MacOS/TouchDesigner")]
    for cand in candidates:
        if cand and os.access(cand, os.X_OK) and _bundle_reports_version(cand):
            return cand
    return None


def _bundle_reports_version(binary):
    """True when a .app binary exposes its bundle version; other layouts pass.

    TouchDesigner has no headless CLI probe, so the check reads the bundle's
    Info.plist the way the native parity profile does. A .app whose plist or
    version is missing is a broken install, not a usable engine.
    """
    app = None
    for parent in [Path(binary).parent, *Path(binary).parents]:
        if parent.suffix == ".app":
            app = parent
            break
    if app is None:
        return True
    plist = app / "Contents" / "Info.plist"
    if not plist.is_file():
        return False
    plutil = shutil.which("plutil") or "/usr/bin/plutil"
    probe = subprocess.run([plutil, "-extract", "CFBundleShortVersionString", "raw",
                            "-o", "-", str(plist)], capture_output=True, text=True)
    return probe.returncode == 0 and bool(probe.stdout.strip())


def require_touchdesigner():
    """Fail closed when no TouchDesigner binary can run the candidate renders."""
    if touchdesigner_binary() is None:
        raise SystemExit("parity-summary: TouchDesigner binary not found (set TD_BIN); "
                         "the rendered parity cases need a licensed TouchDesigner host")


def checkout_source():
    """The HEAD of the checkout whose sweep a ledger must be bound to."""
    result = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "HEAD"],
                            capture_output=True, text=True)
    return result.stdout.strip() if result.returncode == 0 else None


def verify_ledger_binding(ledger):
    """Fail closed when the ledger was not produced at this checkout and pin.

    The sweep's ledger writer records the source SHA and the pinned authority
    beside the ledger. A summary must never read stale rows as a pass at a
    different source.
    """
    path = Path(str(ledger) + ".binding.json")
    if not path.is_file():
        raise SystemExit("parity-summary: the ledger has no binding (%s); produce it "
                         "with the sweep on the TouchDesigner host" % path)
    try:
        binding = json.loads(path.read_text())
    except ValueError:
        raise SystemExit("parity-summary: the ledger binding %s is not valid JSON" % path)
    head = checkout_source()
    pin = pinned_revision()
    if binding.get("source") != head or binding.get("pin") != pin:
        raise SystemExit("parity-summary: the ledger is bound to source %s at pin %s, "
                         "but this checkout is %s at pin %s"
                         % (binding.get("source"), binding.get("pin"), head, pin))
    expected = binding.get("ledger_sha256")
    if not expected:
        raise SystemExit("parity-summary: the ledger binding %s does not bind the ledger "
                         "bytes; re-run the sweep so the writer binds them" % path)
    actual = hashlib.sha256(ledger.read_bytes()).hexdigest()
    if actual != expected:
        raise SystemExit("parity-summary: the ledger bytes do not match the binding "
                         "(%s != %s)" % (actual, expected))


def main(argv):
    sweep_status = 0
    scoped = None
    if argv[:1] == ["--ledger"] and len(argv) == 2:
        ledger = Path(argv[1])
        verify_ledger_binding(ledger)
    elif argv and all(not a.startswith("-") for a in argv):
        staged = RENDER_SET.read_text().split() if RENDER_SET.exists() else []
        unknown = sorted(set(argv) - set(staged))
        if unknown:
            raise SystemExit("parity-summary: not staged cases: %s" % ", ".join(unknown))
        scoped = list(argv)
        require_touchdesigner()
        work = Path(os.environ.get("NM_PARITY_WORK", ROOT / "parity" / "out" / "parity-summary"))
        work.mkdir(parents=True, exist_ok=True)
        ref_root = resolve_reference(work)
        dep_err, extra_env = install_reference_dependencies(ref_root, work)
        if dep_err:
            raise SystemExit("parity-summary: %s at %s" % (dep_err, ref_root))
        pin = pinned_revision()
        print("parity-summary: reference root %s at %s" % (ref_root, pin))
        ledger = work / "ledger.tsv"
        if ledger.exists():
            ledger.unlink()
        env = dict(os.environ, LEDGER_PATH=str(ledger), NM_REFERENCE_ROOT=ref_root, NM_REFERENCE_SHA=pin,
                   NM_CASES=" ".join(scoped), **extra_env)
        sweep_status = subprocess.run(
            ["bash", str(ROOT / "parity" / "sweep.sh")], cwd=str(ROOT), env=env).returncode
        verify_ledger_binding(ledger)
    elif not argv:
        work = Path(os.environ.get("NM_PARITY_WORK", ROOT / "parity" / "out" / "parity-summary"))
        ledger = work / "ledger.tsv"
        if touchdesigner_binary() is None:
            # No TouchDesigner can run in this runtime (a verification checkout,
            # not the render host). Grade the sweep's ledger only when the sweep
            # writer bound it to this checkout's HEAD and the current pin;
            # verify_ledger_binding fails closed on anything else. Without a
            # bound ledger the run still fails closed: a summary must never
            # grade rows it cannot attribute to a sweep at this source.
            if not ledger.is_file():
                raise SystemExit("parity-summary: TouchDesigner binary not found (set TD_BIN); "
                                 "the rendered parity cases need a licensed TouchDesigner host")
            verify_ledger_binding(ledger)
            sweep_status = 0
        else:
            work.mkdir(parents=True, exist_ok=True)
            ref_root = resolve_reference(work)
            dep_err, extra_env = install_reference_dependencies(ref_root, work)
            if dep_err:
                raise SystemExit("parity-summary: %s at %s" % (dep_err, ref_root))
            pin = pinned_revision()
            print("parity-summary: reference root %s at %s" % (ref_root, pin))
            if ledger.exists():
                ledger.unlink()
            env = dict(os.environ, LEDGER_PATH=str(ledger), NM_REFERENCE_ROOT=ref_root, NM_REFERENCE_SHA=pin,
                       **extra_env)
            sweep_status = subprocess.run(
                ["bash", str(ROOT / "parity" / "sweep.sh")], cwd=str(ROOT), env=env).returncode
            verify_ledger_binding(ledger)
    else:
        raise SystemExit(__doc__)
    expected = scoped if scoped else (RENDER_SET.read_text().split() if RENDER_SET.exists() else [])
    rows = read_ledger(ledger) if ledger.exists() else {}
    counts, lines = summarize(expected, rows)
    for line in lines:
        print(line)
    print("PARITY-SUMMARY " + json.dumps(counts, separators=(",", ":")))
    return 0 if (sweep_status == 0 and counts["expected"]
                 and counts["fail"] == 0 and counts["missing"] == 0) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
